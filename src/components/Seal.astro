---
/**
 * 工作室印章：红底方印，白字「长」。
 * 字形是思源宋体的路径（scripts/subset-fonts.mjs 生成），不依赖访客机器上的字体。
 * 与应用图标（深色方块 + 单字）同属「一字一作」的图形系统。
 */
import glyphs from '../generated/glyphs.json';

interface Props {
  size?: number;
  stamp?: boolean;
  class?: string;
}
const { size = 36, stamp = false, class: className } = Astro.props;
const g = glyphs['长'];
const cx = (g.x1 + g.x2) / 2;
const cy = (g.y1 + g.y2) / 2;
const k = 0.062;
---

<svg
  class:list={['seal', { 'seal--stamp': stamp }, className]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role="img"
  aria-label="长作 Longform Works"
>
  <path d="M6 4 H93 Q96 4 96 7 V94 Q96 96 93 96 H8 Q4 96 4 92 V7 Q4 4 6 4 Z" fill="var(--seal)"></path>
  <path d={g.d} fill="var(--seal-ink)" transform={`translate(50 50) scale(${k}) translate(${-cx} ${-cy})`}></path>
</svg>

<style>
  .seal {
    display: block;
    flex: none;
  }

  /* 落印：页面加载时一次，切换语言时再一次（切换时不延迟） */
  .seal--stamp {
    transform-box: view-box;
    transform-origin: 33% 46%;
    animation: stamp 640ms cubic-bezier(0.2, 0.9, 0.3, 1) 200ms both;
  }

  :global(.seal--restamp) {
    animation-delay: 0ms !important;
  }

  @keyframes stamp {
    from {
      opacity: 0;
      transform: scale(1.25) rotate(-3deg);
    }
    28% {
      opacity: 1;
    }
    60% {
      opacity: 1;
      transform: scale(0.985) rotate(0.4deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seal--stamp {
      animation: none;
    }
  }
</style>
