---
/** 作品列表（一种语言）。列表为空时只显示一句说明。 */
import { works } from '../data/works';
import { copy, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const lang = locales.find((l) => l.code === locale)!.lang;
---

<main id={`main-${locale}`} class="works" tabindex="-1" lang={lang} data-locale={locale}>
  <h1 class="works__title">{t.works}</h1>
  {
    works.length === 0 ? (
      <p class="works__empty">{t.worksEmpty}</p>
    ) : (
      <ol class="works__list">
        {works.map((w) => (
          <li class="work">
            <span class="work__glyph" lang="zh-Hans" aria-hidden="true">
              {w.glyph}
            </span>
            <div class="work__body">
              <h2 class="work__name">
                {w.href ? (
                  <a href={w.href}>
                    <span lang="zh-Hans">{w.name}</span> <span lang="en">{w.latin}</span>
                  </a>
                ) : (
                  <>
                    <span lang="zh-Hans">{w.name}</span> <span lang="en">{w.latin}</span>
                  </>
                )}
              </h2>
              <p class="work__summary">{w.summary[locale]}</p>
              <p class="work__meta">
                <span>{t.meta(w.platform)}</span>
                <span>{w.year}</span>
              </p>
            </div>
          </li>
        ))}
      </ol>
    )
  }
</main>

<style>
  .works {
    width: 100%;
    max-width: var(--page);
    margin: 0 auto;
    padding: 2.5rem var(--gutter) 2rem;
    font-family: var(--sans);
    font-size: 1.125rem;
    flex: 1;
  }

  .works__title {
    margin: 0 0 1.5rem;
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .works__title:lang(zh-Hans) {
    font-family: var(--serif-cjk);
    letter-spacing: 0.04em;
  }

  .works__empty {
    margin: 0;
    color: var(--ink-soft);
  }

  .works__list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 48rem;
  }

  .work {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    column-gap: 1rem;
    align-items: start;
    padding: 1.25rem 0;
    border-top: 1px solid var(--rule);
  }

  .work:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .work__glyph {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border-radius: 22%;
    background: var(--icon);
    color: var(--icon-ink);
    font-family: var(--serif-cjk);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
  }

  .work__name {
    margin: 0.3rem 0 0.35rem;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .work__name [lang='zh-Hans'] {
    font-family: var(--serif-cjk);
    font-weight: 600;
  }

  .work__name a {
    text-decoration: none;
  }

  .work__name a:hover {
    text-decoration: underline;
  }

  .work__summary {
    margin: 0 0 0.5rem;
    max-width: 44rem;
  }

  .work__meta {
    margin: 0;
    display: flex;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 40em) {
    .work {
      grid-template-columns: 2.5rem 1fr;
    }

    .work__body {
      display: contents;
    }

    .work__name {
      margin: 0.35rem 0 0;
    }

    .work__summary,
    .work__meta {
      grid-column: 1 / -1;
    }

    .work__summary {
      margin-top: 0.75rem;
    }
  }
</style>
