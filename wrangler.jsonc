{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "longform-works",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "longform.works", "custom_domain": true },
    { "pattern": "www.longform.works", "custom_domain": true },
    { "pattern": "longform.work", "custom_domain": true },
    { "pattern": "www.longform.work", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
